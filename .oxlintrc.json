        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "error",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off"
      },
      "jsPlugins": [
        "@stylistic/eslint-plugin"
      ],
      "env": {
        "es2026": true
      },
      "plugins": [
        "eslint",
        "typescript",
        "react"
      ]
    }
  ]
}
